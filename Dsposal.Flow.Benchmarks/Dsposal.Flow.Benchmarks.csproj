<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Dsposal.Flow.Benchmarks</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
      <PackageReference Include="Bogus" Version="35.6.5" />
      <PackageReference Include="ClosedXML" Version="0.105.0" />
      <PackageReference Include="EPPlus" Version="8.5.4" />
      <PackageReference Include="Sylvan.Data" Version="0.2.17" />
      <PackageReference Include="Sylvan.Data.Excel" Version="0.5.6" />
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="inputs/**/*" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
