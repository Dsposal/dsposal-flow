<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <Company>Dsposal Ltd</Company>
        <Version>1.0.0-beta</Version>
        <RootNamespace>Dsposal.Flow</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommandLineParser" Version="2.9.1" />
      <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
      <PackageReference Include="Spectre.Console" Version="0.55.2" />
      <PackageReference Include="Spectre.Console.Json" Version="0.55.2" />
      <PackageReference Include="Sylvan.Data" Version="0.2.17" />
      <PackageReference Include="Sylvan.Data.Csv" Version="1.4.4" />
      <PackageReference Include="Sylvan.Data.Excel" Version="0.5.6" />
      <PackageReference Include="XenoAtom.Logging" Version="1.2.0" />
      <PackageReference Include="XenoAtom.Logging.Terminal" Version="1.2.0" />
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="input/**\*.*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    

</Project>
